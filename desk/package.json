{
  "name": "summa",
  "version": "1.3.3",
  "description": "Summa: dois PDFs, calculadora e tutor numa janela, ao lado do Xournal++",
  "main": "main.cjs",
  "scripts": {
    "prestart": "node scripts/visual-helper.mjs",
    "start": "electron .",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test --test-timeout=180000 --test-force-exit tests/*.test.mjs",
    "pretest": "node scripts/core-gate.mjs",
    "check": "node tests/syntax-check.mjs",
    "typecheck": "node scripts/typecheck-ratchet.mjs",
    "lint": "eslint .",
    "build:bend": "node ../core/build-safe.mjs",
    "test:proof": "node ../core/proof.mjs",
    "test:parity": "node tests/parity.mjs",
    "hunts": "node tests/run-hunts.mjs",
    "ui": "node tests/run-ui.mjs",
    "verify:bend": "node ../core/verify.mjs",
    "test:ui:x3": "node tests/smoke-x3.mjs",
    "test:app": "node tests/app-smoke.mjs",
    "test:packaged": "node tests/packaged-app-ui.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "geogebra:offline": "node scripts/geogebra-offline.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:claude": "node scripts/claude-doctor.mjs",
    "triage": "node scripts/triage.mjs",
    "test:claude-ui": "node tests/run-claude-ui.mjs",
    "install-app": "node scripts/install-app.mjs",
    "appimage:linux": "node scripts/build-linux-appimage.mjs",
    "installer:windows": "node scripts/build-windows-installer.mjs",
    "installer:macos": "node scripts/build-macos-dmg.mjs",
    "update": "node scripts/update-cli.mjs",
    "update:keygen": "node scripts/update-release.mjs keygen",
    "update:sign": "node scripts/update-release.mjs sign",
    "update:release:verify": "node scripts/update-release.mjs verify",
    "update:rehearsal": "node scripts/update-rehearsal.mjs"
  },
  "keywords": [],
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "chart.js": "4.6.1",
    "dompurify": "^3.4.17",
    "electron": "^45.3.2",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "vite": "7.3.8"
  },
  "productName": "Summa"
}
